# French (France) - our own text; vanilla names come from Mojang (tools/lang/build_langs.py)
itemGroup.buzzybeesbackport=Buzzy Bees Backport
config.buzzybeesbackport.honey=Miel
config.buzzybeesbackport.honey.tooltip=Fioles de miel, rayons de miel, blocs de miel et blocs de rayon de miel.
config.buzzybeesbackport.honey.enabled=Activé
config.buzzybeesbackport.honey.enabled.tooltip=Fioles de miel, rayons de miel, blocs de miel et blocs de rayon de miel. Désactivé, rien n'est enregistré.
config.buzzybeesbackport.bees=Abeilles
config.buzzybeesbackport.bees.tooltip=Abeilles, nids d'abeilles et ruches.
config.buzzybeesbackport.bees.enabled=Activé
config.buzzybeesbackport.bees.enabled.tooltip=Abeilles, nids d'abeilles et ruches. Désactivé, rien n'est enregistré.
config.buzzybeesbackport.nests=Génération des nids
config.buzzybeesbackport.nests.tooltip=Nids d'abeilles générés sur les arbres et apparaissant avec les pousses près des fleurs.
config.buzzybeesbackport.nests.enabled=Activé
config.buzzybeesbackport.nests.enabled.tooltip=Des nids d'abeilles se génèrent sur les chênes et les bouleaux des chunks nouvellement générés, et apparaissent parfois quand une pousse grandit près de fleurs.
config.buzzybeesbackport.nests.moddedBiomes=Nids dans les biomes d'autres mods
config.buzzybeesbackport.nests.moddedBiomes.tooltip=Les biomes d'autres mods reçoivent aussi des nids, selon leurs types de biome Forge : les plaines comme les Plaines (5 %% des arbres), les forêts de feuillus comme la Forêt (0,2 %%).
config.buzzybeesbackport.golems=Golems de fer
config.buzzybeesbackport.golems.tooltip=Les golems de fer se fissurent à mesure qu'ils sont blessés et se réparent avec des lingots de fer.
config.buzzybeesbackport.golems.enabled=Activé
config.buzzybeesbackport.golems.enabled.tooltip=Les golems de fer se fissurent à mesure qu'ils perdent de la vie et peuvent être réparés avec des lingots de fer.
config.buzzybeesbackport.tweaks=Autres changements de la 1.15
config.buzzybeesbackport.tweaks.tooltip=Les petits changements de la 1.15, chacun avec son propre interrupteur.
config.buzzybeesbackport.tweaks.enabled=Activé
config.buzzybeesbackport.tweaks.enabled.tooltip=Les petits changements de la 1.15. Désactivé, aucun ne s'applique, quels que soient leurs propres interrupteurs.
config.buzzybeesbackport.compat=Compatibilité
config.buzzybeesbackport.compat.tooltip=Mondes et blocs d'autres mods qui ajoutent les mêmes choses.
config.buzzybeesbackport.compat.convertRemoved=Convertir le contenu d'un mod retiré
config.buzzybeesbackport.compat.convertRemoved.tooltip=Convertit les blocs, objets et abeilles laissés par un autre mod qui les ajoutait, quand ce mod est retiré d'un monde.
tooltip.buzzybeesbackport.beehive.bees=Abeilles : %s / %s
tooltip.buzzybeesbackport.beehive.honey=Miel : %s / %s
config.buzzybeesbackport.tweaks.endStoneBricks=Dureté de la pierre taillée de l'End
config.buzzybeesbackport.tweaks.endStoneBricks.tooltip=La pierre taillée de l'End se mine aussi lentement que la roche (dureté 3) et résiste aux explosions comme elle (9).
config.buzzybeesbackport.tweaks.boatFuel=Bateaux comme combustible
config.buzzybeesbackport.tweaks.boatFuel.tooltip=Un bateau brûle assez longtemps pour cuire 6 objets.
config.buzzybeesbackport.tweaks.spongeDries=Les éponges sèchent dans le Nether
config.buzzybeesbackport.tweaks.spongeDries.tooltip=Une éponge mouillée posée dans le Nether sèche instantanément.
config.buzzybeesbackport.tweaks.railFacing=Les rails suivent le regard du joueur
config.buzzybeesbackport.tweaks.railFacing.tooltip=Un rail qui n'a rien à quoi se raccorder est posé dans la direction vers laquelle vous regardez.
config.buzzybeesbackport.tweaks.fernSeeds=Les grandes fougères donnent des graines
config.buzzybeesbackport.tweaks.fernSeeds.tooltip=Les grandes fougères donnent des graines de blé, comme les hautes herbes.
config.buzzybeesbackport.tweaks.spawnEggBabies=Les œufs d'apparition créent des bébés zombies
config.buzzybeesbackport.tweaks.spawnEggBabies.tooltip=Utiliser l'œuf d'apparition correspondant sur un zombie, momifié, zombie-villageois, cochon-zombie ou noyé adulte fait apparaître un bébé.
config.buzzybeesbackport.tweaks.babyAnimals=Bébés dans les groupes d'animaux
config.buzzybeesbackport.tweaks.babyAnimals.tooltip=Les animaux qui apparaissent en groupe sont parfois des bébés : 5 %% pour les vaches, moutons, cochons, poules et renards, 10 %% pour les loups, chevaux et lamas.
config.buzzybeesbackport.tweaks.parrotImitation=Les perroquets imitent moins de créatures
config.buzzybeesbackport.tweaks.parrotImitation.tooltip=Les perroquets n'imitent plus les endermen, les ours blancs, les loups ni les cochons-zombies.
config.buzzybeesbackport.tweaks.creativeEating=Manger en mode Créatif
config.buzzybeesbackport.tweaks.creativeEating.tooltip=La nourriture et le gâteau peuvent être mangés en mode Créatif.
config.buzzybeesbackport.tweaks.bedSpawn=Les lits définissent la réapparition
config.buzzybeesbackport.tweaks.bedSpawn.tooltip=Utiliser un lit définit votre point de réapparition et vous l'indique, même quand il est trop tôt pour dormir.
config.buzzybeesbackport.tweaks.gameRules=Règles de jeu de la 1.15
config.buzzybeesbackport.tweaks.gameRules.tooltip=Ajoute les règles de jeu fallDamage, fireDamage, drowningDamage, doImmediateRespawn et doInsomnia.
config.buzzybeesbackport.tweaks.dispensers=Changements des distributeurs
config.buzzybeesbackport.tweaks.dispensers.tooltip=Les distributeurs remplissent les fioles avec de l'eau, posent les porte-armures et allument les feux de camp avec des charges de feu.
config.buzzybeesbackport.tweaks.bellRedstone=Les cloches sonnent avec la redstone
config.buzzybeesbackport.tweaks.bellRedstone.tooltip=Une cloche sonne quand elle est alimentée par de la redstone.
config.buzzybeesbackport.tweaks.splashTexts=Textes d'accueil de la 1.15
config.buzzybeesbackport.tweaks.splashTexts.tooltip=Le menu principal peut afficher les trois nouveaux textes d'accueil de la 1.15.
config.buzzybeesbackport.compat.duplicates=Blocs en double
config.buzzybeesbackport.compat.duplicates.tooltip=Quand un autre mod installé ajoute les mêmes blocs et objets : OURS masque les siens, THEIRS masque les nôtres, BOTH ne masque rien.
config.buzzybeesbackport.campfire=Feu de camp
config.buzzybeesbackport.campfire.tooltip=Le feu de camp, quand Village & Pillage Backport n'est pas installé.
config.buzzybeesbackport.campfire.enabled=Activé
config.buzzybeesbackport.campfire.enabled.tooltip=Indique si ce mod ajoute sa propre copie du feu de camp quand Village & Pillage Backport n'est pas installé. S'il est installé, c'est son feu de camp qui est utilisé et ce réglage n'a aucun effet.
config.buzzybeesbackport.campfire.cookTime=Temps de cuisson
config.buzzybeesbackport.campfire.cookTime.tooltip=Temps de cuisson d'un objet, en ticks. Celui de la 1.14 est de 600 (30 secondes), trois fois celui d'un fourneau.
config.buzzybeesbackport.campfire.extraFoods=Aliments supplémentaires
config.buzzybeesbackport.campfire.extraFoods.tooltip=Ce que le feu de camp cuit. Par défaut : toutes les recettes de fourneau dont l'entrée et la sortie sont de la nourriture, ce qui correspond à la liste de la 1.14 (viande crue, poisson cru, pommes de terre) plus les aliments crus de tous les mods. Ajoutez un objet que la valeur par défaut omet sous la forme 'modid:item' (cuit comme le ferait le fourneau) ou 'modid:item=modid:result' (cuit en ce résultat). Ajoutez ':meta' après l'un ou l'autre pour choisir une variante, par ex. 'minecraft:fish:1=minecraft:cooked_fish:1'.
config.buzzybeesbackport.campfire.excludedFoods=Aliments exclus
config.buzzybeesbackport.campfire.excludedFoods.tooltip=Objets que le feu de camp refuse, même si la règle ci-dessus les cuirait, sous la forme 'modid:item' ou 'modid:item:meta'.
config.buzzybeesbackport.tweaks.craftingShiftClick=Maj + clic vers la grille de fabrication
config.buzzybeesbackport.tweaks.craftingShiftClick.tooltip=À un établi, un Maj + clic sur une pile de votre inventaire la déplace dans la grille de fabrication, et seulement vers l'autre partie de l'inventaire quand la grille n'a plus de place.
config.buzzybeesbackport.tweaks.elytraJump=Ouvrir les élytres en montant
config.buzzybeesbackport.tweaks.elytraJump.tooltip=Les élytres peuvent s'ouvrir juste après un saut, pendant que vous montez encore.
config.buzzybeesbackport.tweaks.toggleSneak=S'accroupir en mode basculer
config.buzzybeesbackport.tweaks.toggleSneak.tooltip=Client : la touche S'accroupir active et désactive l'accroupissement au lieu de devoir être maintenue.
config.buzzybeesbackport.tweaks.toggleSprint=Courir en mode basculer
config.buzzybeesbackport.tweaks.toggleSprint.tooltip=Client : la touche Courir active et désactive la course au lieu de devoir être maintenue.
config.buzzybeesbackport.tweaks.dispensedFireworks=Les feux d'artifice distribués volent droit devant
config.buzzybeesbackport.tweaks.dispensedFireworks.tooltip=Une fusée de feu d'artifice tirée par un distributeur vole tout droit dans la direction vers laquelle le distributeur est orienté.
config.buzzybeesbackport.tweaks.advancementBees=Abeilles dans les progrès d'Agriculture
config.buzzybeesbackport.tweaks.advancementBees.tooltip=« Deux par deux » demande aussi de faire se reproduire des abeilles, et « Une alimentation équilibrée » demande aussi une fiole de miel.
config.buzzybeesbackport.tweaks.parrotsWhileRiding=Les perroquets restent sur les épaules
config.buzzybeesbackport.tweaks.parrotsWhileRiding.tooltip=Les perroquets restent sur vos épaules pendant que vous montez un cheval, un bateau, un wagonnet ou toute autre chose.
config.buzzybeesbackport.tweaks.xpWithLoot=L'expérience tombe avec le butin
config.buzzybeesbackport.tweaks.xpWithLoot.tooltip=Une créature ou un joueur qui meurt lâche son expérience immédiatement, avec son butin, au lieu d'attendre la fin de l'animation de mort.
