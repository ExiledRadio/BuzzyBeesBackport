config.buzzybeesbackport.campfire=Lagerfeuer
config.buzzybeesbackport.campfire.tooltip=Das Lagerfeuer, wenn Village & Pillage Backport nicht installiert ist.
config.buzzybeesbackport.campfire.enabled=Aktiviert
config.buzzybeesbackport.campfire.enabled.tooltip=Ob dieser Mod seine eigene Kopie des Lagerfeuers hinzufügt, wenn Village & Pillage Backport nicht installiert ist. Ist er installiert, wird dessen Lagerfeuer verwendet und dies bewirkt nichts.
config.buzzybeesbackport.campfire.cookTime=Garzeit
config.buzzybeesbackport.campfire.cookTime.tooltip=Wie lange ein Gegenstand zum Garen braucht, in Ticks. In 1.14 sind es 600 (30 Sekunden), dreimal so lang wie in einem Ofen.
config.buzzybeesbackport.campfire.extraFoods=Zusätzliche Nahrung
config.buzzybeesbackport.campfire.extraFoods.tooltip=Was das Lagerfeuer gart. Standardmäßig: jedes Ofenrezept, dessen Zutat und Ergebnis beide Nahrung sind, also die eigene Liste von 1.14 (rohes Fleisch, roher Fisch, Kartoffeln) plus die rohen Lebensmittel jedes Mods. Füge einen Gegenstand, den der Standard auslässt, als 'modid:item' hinzu (gegart wie im Ofen) oder als 'modid:item=modid:result' (zu diesem Ergebnis gegart). Hänge ':meta' an eines davon an, um eine Variante zu wählen, z. B. 'minecraft:fish:1=minecraft:cooked_fish:1'.
config.buzzybeesbackport.campfire.excludedFoods=Ausgeschlossene Nahrung
config.buzzybeesbackport.campfire.excludedFoods.tooltip=Gegenstände, die das Lagerfeuer ablehnt, obwohl die Regel oben sie garen würde, als 'modid:item' oder 'modid:item:meta'.
tile.buzzybeesbackport.campfire.name=Lagerfeuer
subtitles.buzzybeesbackport.block.campfire.crackle=Lagerfeuer knistert

