config.buzzybeesbackport.nests.moddedBiomes=Gniazda w biomach innych modów
config.buzzybeesbackport.nests.moddedBiomes.tooltip=Biomy innych modów też dostają gniazda, według swoich typów biomów Forge: równiny jak Równiny (5%% drzew), lasy liściaste jak Lasy (0,2%%).
config.buzzybeesbackport.golems=Żelazne golemy
